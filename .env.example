# 生产环境必须设置，用于保护 /api/cron/* 定时任务接口
CRON_SECRET=replace-with-a-long-random-secret

# 部署后的公开网址，用于生成 Open Graph 绝对地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI Responses API：内容摘要与行业周报
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5.6-luna
OPENAI_REPORT_MODEL=gpt-5.6-terra

# 回填脚本连接到正在运行的网站
CONTENT_JOB_BASE_URL=http://localhost:3000
